# Name shown in the header and page title.
GLYPHYARD_NAME="Glyphyard"

# Optional. Comma-separated list of families this instance will serve.
# Leave empty to allow every Google Font. Setting it stops other people
# from using your domain as a free font CDN.
# GLYPHYARD_FAMILIES="Inter,Playfair Display,JetBrains Mono"

# Optional. Sites allowed to embed your fonts (subdomains included).
# Leave empty to allow any site.
# GLYPHYARD_ALLOWED_ORIGINS="example.com,another.org"

# Optional. Show a Spillcheck privacy badge in the footer (loads an image from Spillcheck).
# GLYPHYARD_SPILLCHECK_BADGE=1
